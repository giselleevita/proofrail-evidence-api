# ══════════════════════════════════════════════════
# ProofRail — Railway Environment Variables
# Copy these into Railway → Project → Variables
# ══════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────
# Admin key — change this to a strong random value (min 32 chars)
PROOFRAIL_ADMIN_KEY=CHANGE-ME-use-openssl-rand-hex-32

# Signing keys for passport evidence bundles (key rotation supported)
# Format: kid:secret,kid2:secret2
PROOFRAIL_SIGNING_KEYS=k1:CHANGE-ME-signing-secret-min-32-chars
PROOFRAIL_SIGNING_KEY_CURRENT=k1

# ── DATABASE ──────────────────────────────────────────
# Option A: Railway Postgres plugin — Railway sets DATABASE_URL automatically.
# Map it to the ProofRail var:
PROOFRAIL_DB_URL=${{Postgres.DATABASE_URL}}

# Option B: SQLite (single instance only, no worker)
# PROOFRAIL_DB_PATH=/data/proofrail.sqlite3

# DB connection pool (tune for Railway hobby: keep low)
PROOFRAIL_DB_POOL_MIN=1
PROOFRAIL_DB_POOL_MAX=10

# ── STORAGE ──────────────────────────────────────────
# Option A: AWS S3
PROOFRAIL_S3_BUCKET=your-proofrail-bucket
PROOFRAIL_S3_REGION=eu-west-1
PROOFRAIL_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
PROOFRAIL_S3_SECRET_ACCESS_KEY=CHANGE-ME

# Option B: Cloudflare R2 (S3-compatible, generous free tier)
# PROOFRAIL_S3_BUCKET=proofrail
# PROOFRAIL_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# PROOFRAIL_S3_REGION=auto
# PROOFRAIL_S3_ACCESS_KEY_ID=<r2-access-key>
# PROOFRAIL_S3_SECRET_ACCESS_KEY=<r2-secret>

# ── OPTIONAL ──────────────────────────────────────────
PROOFRAIL_DEMO_MODE=0
PROOFRAIL_RPM=120
PROOFRAIL_PROMETHEUS_METRICS=1

# Railway injects PORT automatically — do not set manually
# PORT=8000
