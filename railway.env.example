# ══════════════════════════════════════════════════
# ProofRail — Railway Environment Variables
# Copy into Railway → Project → Variables → Raw Editor
# ══════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────
PROOFRAIL_ADMIN_KEY=CHANGE-ME-use-openssl-rand-hex-32
PROOFRAIL_SIGNING_KEYS=k1:CHANGE-ME-signing-secret-min-32-chars
PROOFRAIL_SIGNING_KEY_CURRENT=k1

# ── DATABASE ──────────────────────────────────────────
# Railway Postgres plugin auto-sets DATABASE_URL
PROOFRAIL_DB_URL=${{Postgres.DATABASE_URL}}
PROOFRAIL_DB_POOL_MIN=1
PROOFRAIL_DB_POOL_MAX=10

# ── STORAGE: Cloudflare R2 (recommended) ────────────────
#
# Setup steps:
#   1. dash.cloudflare.com → R2 → Create bucket (name: proofrail-evidence)
#   2. R2 → Manage R2 API Tokens → Create API Token
#      Permissions: Object Read & Write
#      Scope: specific bucket → proofrail-evidence
#   3. Copy Access Key ID + Secret Access Key below
#   4. Account ID: dash.cloudflare.com → right sidebar → Account ID
#
PROOFRAIL_S3_BUCKET=proofrail-evidence
PROOFRAIL_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
PROOFRAIL_S3_REGION=auto
PROOFRAIL_S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
PROOFRAIL_S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# Optional: public R2 subdomain for direct passport downloads
# PROOFRAIL_S3_PUBLIC_URL=https://evidence.yourdomain.com

# ── STORAGE: AWS S3 (alternative) ──────────────────────
# PROOFRAIL_S3_BUCKET=proofrail-evidence
# PROOFRAIL_S3_REGION=eu-west-1
# PROOFRAIL_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# PROOFRAIL_S3_SECRET_ACCESS_KEY=CHANGE-ME

# ── OPTIONAL ──────────────────────────────────────────
PROOFRAIL_DEMO_MODE=0
PROOFRAIL_RPM=120
PROOFRAIL_PROMETHEUS_METRICS=1
# PORT is injected by Railway automatically
